# ========================================
# Medisoft Environment Variables (Docker)
# Use this file for docker-compose deployment
# ----------------------------------------
# Copy .env.example to .env.docker and modify
# ========================================

# ----------------------------------------
# PostgreSQL Database Configuration
# For Docker: DB_HOST should be the service name 'db'
# ----------------------------------------
DB_NAME=medisoft
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=db
DB_PORT=5432

# ----------------------------------------
# Django / Backend Configuration
# ----------------------------------------
DJANGO_SECRET_KEY=django-insecure-dev-key-do-not-use-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,backend,127.0.0.1

# Default admin user (auto-created on first run with full superuser privileges)
DJANGO_ADMIN_EMAIL=admin@medisoft.local
DJANGO_ADMIN_PASSWORD=admin
BACKEND_PORT=8000

# ----------------------------------------
# Frontend Configuration
# VITE_API_URL should be a relative path for Vite proxy to work in development
# VITE_BACKEND_URL is used by the Vite proxy to forward requests
# When accessed via browser on localhost, proxy handles /api -> http://backend:8000/api
# ----------------------------------------
VITE_API_URL=/api
VITE_BACKEND_URL=http://backend:8000

# Frontend development server (not used in production build)
FRONTEND_PORT=5173

# ----------------------------------------
# Docker-only Configuration
# ----------------------------------------
PGADMIN_EMAIL=admin@medisoft.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8081
