# ========================================
# Medisoft Environment Variables (Docker)
# Use this file for docker-compose deployment
# ----------------------------------------
# Copy .env.example to .env.docker and modify
# ========================================

# ----------------------------------------
# PostgreSQL Database Configuration
# For Docker: DB_HOST should be the service name 'db'
# ----------------------------------------
DB_NAME=medisoft
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=db
DB_PORT=5432

# Django / Backend Configuration
# Note: Generate a secure secret key for production using:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=django-insecure-dev-key-do-not-use-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,backend,127.0.0.1

# Default admin user (auto-created on first run)
DJANGO_ADMIN_EMAIL=admin@medisoft.local
DJANGO_ADMIN_PASSWORD=admin

# Backend server settings
BACKEND_PORT=8000

# ----------------------------------------
# Frontend Configuration
# VITE_API_URL points to backend container hostname
# ----------------------------------------
VITE_API_URL=http://backend:8000/api

# Frontend server (production build uses Nginx on port 80)
FRONTEND_PORT=80

# ----------------------------------------
# Docker-only Configuration
# ----------------------------------------
PGADMIN_EMAIL=admin@medisoft.test
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8081
