# ========================================
# Medisoft Environment Variables
# Copy this file to .env.local for local development
# Copy this file to .env.docker for Docker deployment
# ========================================

# ----------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------
DB_NAME=medisoft
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432

# ----------------------------------------
# Django / Backend Configuration
# ----------------------------------------
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-random-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Default admin user (auto-created on first run with full superuser privileges)
DJANGO_ADMIN_EMAIL=admin@medisoft.com
DJANGO_ADMIN_PASSWORD=admin

# Backend server settings
BACKEND_PORT=8000

# ----------------------------------------
# Frontend Configuration - LOCAL DEVELOPMENT
# For local dev with Vite proxy: use relative path /api
# For direct backend access: http://localhost:8000/api
# VITE_BACKEND_URL specifies where the proxy forwards to
# ----------------------------------------
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:8000/api

# Frontend development server
FRONTEND_PORT=5173

# ----------------------------------------
# Docker-only Configuration
# When deploying with docker-compose.yml, use .env.docker instead
# ----------------------------------------
# DB_HOST should be 'db' (service name), not localhost
DB_HOST=db

# Default pgAdmin credentials
PGADMIN_EMAIL=admin@medisoft.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8081
